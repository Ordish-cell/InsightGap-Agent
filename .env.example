LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false

APP_ENV=local
SECRET_KEY=change-me
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_CREDENTIALS_ENCRYPTION_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# === MySQL (legacy, read-only, do not delete) ===
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=open_deep_research

# === PostgreSQL (active) ===
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DATABASE=agent_os
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hello_agents_vectors
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=your_username
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60
ENABLE_NEO4J=false
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v4
EMBED_API_KEY=
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_BATCH_SIZE=10
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
QWEN_VISION_API_KEY=
QWEN_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3.6-plus
OPEN_DEEP_RESEARCH_MODE=adapter
ARTIFACT_STORAGE_PATH=uploads/artifacts
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GITHUB_TOKEN=
FEED_ARXIV_ENABLED=true
FEED_ARXIV_CATEGORIES=cs.AI,cs.CL,cs.LG
SERPAPI_API_KEY=
FEED_RSS_ENABLED=true
FEED_RSS_URLS=https://blog.langchain.com/rss/,https://qdrant.tech/blog/rss.xml
TAVILY_API_KEY=
ENABLE_OPEN_DEEP_RESEARCH=true

# RAG hybrid retrieval backend
# Keep python_bm25 as the safe default; switch to qdrant_hybrid after synthetic eval passes.
RAG_HYBRID_BACKEND=qdrant_hybrid
QDRANT_HYBRID_COLLECTION=agent_os_documents_v3
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=bm25
QDRANT_SPARSE_ENCODER=hashing_sparse
QDRANT_SPARSE_MODEL=Qdrant/bm25
QDRANT_CLOUD_INFERENCE=false
QDRANT_FUSION_METHOD=rrf
QDRANT_HYBRID_FALLBACK=true
QDRANT_SPARSE_HASH_SIZE=2000003

# LLM supervisor route_plan override for web-app runtime
AGENT_LLM_SUPERVISOR_ENABLED=true
AGENT_LLM_SUPERVISOR_MODE=full
AGENT_LLM_SUPERVISOR_TEMPERATURE=0
AGENT_LLM_SUPERVISOR_TIMEOUT_SECONDS=20
