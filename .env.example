# === PostgreSQL (active) ===
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=agent_os
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=agent_os_documents
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60
ENABLE_NEO4J=false
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v4
EMBED_API_KEY=
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=
OPEN_DEEP_RESEARCH_MODE=adapter
# ── Open Deep Research (upstream) ─────────────────────────────────
ENABLE_OPEN_DEEP_RESEARCH=true
ODR_SEARCH_API=tavily
ODR_ALLOW_CLARIFICATION=false
ODR_MAX_CONCURRENT_RESEARCH_UNITS=2
ODR_MAX_RESEARCHER_ITERATIONS=2
ODR_MAX_REACT_TOOL_CALLS=4
ODR_TIMEOUT_SECONDS=600
ODR_RESEARCH_MODEL=openai:qwen-plus
ODR_SUMMARIZATION_MODEL=openai:qwen-plus
ODR_COMPRESSION_MODEL=openai:qwen-plus
ODR_FINAL_REPORT_MODEL=openai:qwen-plus
ODR_RESEARCH_MODEL_MAX_TOKENS=10000
ODR_SUMMARIZATION_MODEL_MAX_TOKENS=8192
ODR_COMPRESSION_MODEL_MAX_TOKENS=8192
ODR_FINAL_REPORT_MODEL_MAX_TOKENS=10000
ODR_MAX_CONTENT_LENGTH=50000
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ARTIFACT_STORAGE_PATH=uploads/artifacts
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === Agent LLM / Aliyun Bailian ===
AGENT_LLM_ENABLED=true
AGENT_LLM_PROVIDER=aliyun
AGENT_LLM_TIMEOUT_SECONDS=60
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_TEMPERATURE=0.2
DASHSCOPE_API_KEY=
ALIYUN_BAILIAN_API_KEY=
ALIYUN_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_FAST_MODEL=qwen3.6-max-preview
AGENT_BALANCED_MODEL=qwen3.6-max-preview
AGENT_STRONG_MODEL=qwen3.7-plus
AGENT_LLM_MODEL=qwen3.6-plus
AGENT_INTENT_MODEL=qwen3.6-max-preview
AGENT_SAFETY_MODEL=qwen3.6-max-preview
AGENT_PLANNER_MODEL=qwen3.6-max-preview
AGENT_RAG_MODEL=qwen3.6-max-preview
AGENT_RESEARCH_MODEL=qwen3.7-plus
AGENT_ARTIFACT_MODEL=qwen3.6-plus
AGENT_MEMORY_MODEL=qwen3.6-max-preview
AGENT_SKILL_MODEL=qwen3.6-max-preview
AGENT_FINAL_MODEL=qwen3.6-plus
AGENT_EMBEDDING_PROVIDER=aliyun
AGENT_EMBEDDING_MODEL=text-embedding-v4
AGENT_INTENT_LLM_ENABLED=true
AGENT_PLANNER_LLM_ENABLED=false
AGENT_MEMORY_LLM_ENABLED=true
AGENT_SKILL_LLM_ENABLED=true
AGENT_SAFETY_LLM_ENABLED=true
AGENT_LLM_USAGE_LOG_ENABLED=true
AGENT_LLM_LOG_PROMPT_PREVIEW=false
AGENT_LLM_LOG_RAW_OUTPUT=false

# === Search / Feed sources ===
FEED_REAL_SOURCES_ENABLED=true
FEED_ALLOW_MOCK_DATA=false
FEED_HOME_CARD_COUNT=3
FEED_REQUIRE_REAL_CARDS=true
FEED_SOURCE_ARXIV_ENABLED=true
FEED_SOURCE_GITHUB_ENABLED=true
FEED_SOURCE_DUCKDUCKGO_ENABLED=true
FEED_SOURCE_TAVILY_ENABLED=false
FEED_SOURCE_SERPAPI_ENABLED=false
FEED_SOURCE_MANUAL_SEED_ENABLED=true
TAVILY_API_KEY=
SERPAPI_API_KEY=
GITHUB_TOKEN=
FEED_REFRESH_ON_HOME_EMPTY=true
FEED_REFRESH_MIN_REAL_CARDS=3
FEED_REFRESH_TIMEOUT_SECONDS=45
FEED_REFRESH_DEDUP_ENABLED=true

# === Homepage / Agent visualization ===
AGENT_TIMELINE_ENABLED=true
AGENT_LANGGRAPH_STATUS_ENABLED=true
AGENT_LANGGRAPH_STATUS_MAX_STEPS=12
AGENT_CHAT_REAL_MESSAGES_ENABLED=true
