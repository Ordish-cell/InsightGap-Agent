APP_ENV=local
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# === MySQL (legacy, read-only, do not delete) ===
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
